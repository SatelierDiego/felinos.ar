---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ImageBlockProps } from '../types/components/ImageBlock';

interface Props extends ImageBlockProps {}

const { images, position = 'left', widths, sizes, aspectRatio, imageClass } = Astro.props;
---

<div class:list={[images.length >= 2 && 'grid grid-rows-2 gap-4']}>
  {
    images.map((img) => (
      <div class="">
        <figure class="">
          <div class:list={['rounded-card shadow-card overflow-hidden', { 'aspect-4/3': !aspectRatio }]} style={aspectRatio ? `aspect-ratio: ${aspectRatio}` : undefined}>
            <Image
              src={img.src}
              alt={img.alt}
              width={widths ? undefined : 800}
              height={widths ? undefined : 600}
              widths={widths}
              sizes={sizes}
              class:list={['h-full w-full object-cover transition-transform duration-500 hover:scale-105', imageClass]}
              loading="lazy"
              decoding="async"
            />
          </div>
          {img.author && (
            <figcaption class="px-3 py-1.5 text-xs leading-snug text-neutral-500 dark:text-neutral-400">
              &copy; {img.author}
            </figcaption>
          )}
        </figure>
      </div>
    ))
  }
</div>
