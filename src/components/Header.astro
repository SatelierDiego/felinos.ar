---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logoBlanco from '@/assets/felinosar-logo-blanco.svg';
import logo from '@/assets/felinosar-logo.svg';
import { SITE } from '@/site.config';

const felinos = await getCollection('felinos');
const pathname = Astro.url.pathname;

const felinosActive = pathname === '/felinos/' || pathname.startsWith('/felinos/');
---

<header id="header-main" data-scrolled="false" class="fixed top-0 right-0 left-0 z-50 bg-gradient-to-b from-black/60 via-black/40 to-transparent transition-all duration-300 data-[scrolled=true]:bg-none data-[scrolled=true]:bg-white data-[scrolled=true]:shadow-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 no-underline" aria-label={`${SITE.name} – inicio`}>
      <Image id="logo-white" src={logoBlanco} alt={SITE.name} width={120} height={30} loading="eager" />
      <Image id="logo-color" src={logo} alt={SITE.name} width={120} height={30} loading="eager" class="hidden" />
    </a>

    <!-- Desktop Nav -->
    <nav aria-label="Navegación principal" class="hidden md:block">
      <ul class="m-0 flex list-none items-center gap-8 p-0">
        <!-- Felinos dropdown -->
        <li class="relative" id="felinos-menu">
          <button
            id="felinos-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="felinos-dropdown"
            data-active={String(felinosActive)}
            class:list={[
              'flex cursor-pointer items-center gap-1 border-0 bg-transparent p-0 text-base font-medium transition-colors duration-150',
              felinosActive ? 'border-b-2 border-white pb-0.5 text-white' : 'text-white/80 hover:text-white',
            ]}
          >
            Felinos
            <svg
              id="felinos-chevron"
              xmlns="http://www.w3.org/2000/svg"
              class="h-3.5 w-3.5 transition-transform duration-200"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </button>

          <!-- Dropdown panel -->
          <div
            id="felinos-dropdown"
            role="menu"
            aria-labelledby="felinos-trigger"
            class="ring-base-200 absolute top-full left-1/2 mt-3 hidden w-56 -translate-x-1/2 overflow-hidden rounded bg-white/95 shadow-lg ring-1 backdrop-blur-sm"
          >
            <!-- Ver todos -->
            <a
              href="/felinos/"
              role="menuitem"
              class:list={[
                'border-base-100 flex items-center gap-2 border-b px-4 py-2.5 text-xs font-semibold tracking-widest uppercase transition-colors',
                pathname === '/felinos/'
                  ? 'text-accent-600 bg-white/90'
                  : 'text-base-400 hover:text-base-700 hover:bg-white/90',
              ]}
            >
              Ver todos los felinos
            </a>

            <!-- Species list -->
            {
              felinos.map((entry) => {
                const href = `/felinos/${entry.data.slug}/`;
                const isActive = pathname === href;
                return (
                  <a
                    href={href}
                    role="menuitem"
                    class:list={[
                      'border-base-50 flex flex-col border-b px-4 py-3 transition-colors last:border-0',
                      isActive ? 'text-accent-700 bg-white/90' : 'text-base-700 hover:bg-white/90',
                    ]}
                  >
                    <span class="text-sm leading-snug font-medium">{entry.data.hero.title}</span>
                    <span class="text-base-400 text-xs italic">{entry.data.scientific_name}</span>
                  </a>
                );
              })
            }
          </div>
        </li>

        <!-- Libros -->
        <li>
          {
            (() => {
              const isActive = pathname === '/libros/';
              return (
                <a
                  id="nav-libros"
                  href="/libros/"
                  data-active={String(isActive)}
                  class:list={[
                    'text-base font-medium no-underline transition-colors duration-150',
                    isActive ? 'border-b-2 border-white pb-0.5 text-white' : 'text-white/80 hover:text-white',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  Libros
                </a>
              );
            })()
          }
        </li>
      </ul>
    </nav>

    <!-- Mobile Burger Button -->
    <button
      id="burger-trigger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="flex cursor-pointer items-center justify-center border-0 bg-transparent p-2 text-white transition-colors md:hidden"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Menu Drawer -->
<div
  id="mobile-menu"
  role="dialog"
  aria-labelledby="burger-trigger"
  aria-modal="true"
  class="fixed inset-0 z-50 hidden before:absolute before:inset-0 before:bg-black/60 before:content-['']"
>
  <!-- Drawer -->
  <div
    class="bg-background bg-base-50 absolute top-0 left-0 z-50 h-full w-72 max-w-[85vw] -translate-x-full transform [scrollbar-width:none] overflow-y-auto px-6 py-4 shadow-xl transition-transform duration-300 [&::-webkit-scrollbar]:hidden"
  >
    <!-- Close button & Logo -->
    <div class="flex items-center justify-between">
      <Image src={logo} alt={SITE.name} width={120} height={30} loading="eager" />
      <button
        id="burger-close"
        aria-label="Cerrar menú"
        class="text-base-600 flex cursor-pointer items-center justify-center border-0 bg-transparent p-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Nav Links -->
    <nav aria-label="Navegación móvil" class="mt-8">
      <ul class="m-0 list-none p-0">
        <li>
          <a
            href="/"
            class:list={[
              'block px-2 py-3 text-base font-medium no-underline transition-colors',
              pathname === '/' ? 'text-accent-600' : 'text-base-700 hover:bg-base-50',
            ]}
          >
            Inicio
          </a>
        </li>
        <li>
          <button
            id="mobile-felinos-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="mobile-felinos-dropdown"
            class:list={[
              'flex w-full cursor-pointer items-center justify-between border-none bg-transparent px-2 py-3 text-left text-base font-medium transition-colors',
              pathname.startsWith('/felinos/') ? 'text-accent-600' : 'text-base-700 hover:bg-base-50',
            ]}
          >
            Felinos
            <svg
              id="mobile-felinos-chevron"
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 transition-transform duration-200"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="mobile-felinos-dropdown" class="hidden overflow-hidden">
            <ul class="m-0 list-none py-1">
              <li>
                <a
                  href="/felinos/"
                  class:list={[
                    'block px-6 py-2 text-sm font-medium no-underline transition-colors',
                    pathname === '/felinos/' ? 'text-accent-600 bg-accent-50' : 'text-base-600 hover:bg-base-50',
                  ]}
                >
                  Ver todos
                </a>
              </li>
              {
                felinos.map((entry) => {
                  const href = `/felinos/${entry.data.slug}/`;
                  const isActive = pathname === href;
                  return (
                    <li>
                      <a
                        href={href}
                        class:list={[
                          'block px-6 py-2 text-sm no-underline transition-colors',
                          isActive ? 'text-accent-600 bg-accent-50' : 'text-base-600 hover:bg-base-50',
                        ]}
                      >
                        {entry.data.hero.title}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </li>
        <li>
          <a
            href="/libros/"
            class:list={[
              'block px-2 py-3 text-base font-medium no-underline transition-colors',
              pathname === '/libros/' ? 'text-accent-600' : 'text-base-700 hover:bg-base-50',
            ]}
          >
            Libros
          </a>
        </li>
      </ul>
    </nav>
  </div>
</div>

<script>
  const trigger = document.getElementById('felinos-trigger');
  const dropdown = document.getElementById('felinos-dropdown');
  const chevron = document.getElementById('felinos-chevron');
  const menu = document.getElementById('felinos-menu');

  function open() {
    dropdown?.classList.remove('hidden');
    trigger?.setAttribute('aria-expanded', 'true');
    chevron?.classList.add('rotate-180');
  }

  function close() {
    dropdown?.classList.add('hidden');
    trigger?.setAttribute('aria-expanded', 'false');
    chevron?.classList.remove('rotate-180');
  }

  trigger?.addEventListener('click', () => {
    const isOpen = trigger.getAttribute('aria-expanded') === 'true';
    isOpen ? close() : open();
  });

  document.addEventListener('click', (e) => {
    if (!menu?.contains(e.target as Node)) close();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  // Mobile menu
  const burgerTrigger = document.getElementById('burger-trigger');
  const burgerClose = document.getElementById('burger-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileBackdrop = document.getElementById('mobile-backdrop');
  const drawer = mobileMenu?.querySelector('div[class*="transform"]');

  function openMobileMenu() {
    mobileMenu?.classList.remove('hidden');
    burgerTrigger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    setTimeout(() => drawer?.classList.remove('-translate-x-full'), 10);
  }

  function closeMobileMenu() {
    drawer?.classList.add('-translate-x-full');
    burgerTrigger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => mobileMenu?.classList.add('hidden'), 300);
  }

  burgerTrigger?.addEventListener('click', openMobileMenu);
  burgerClose?.addEventListener('click', closeMobileMenu);
  mobileBackdrop?.addEventListener('click', closeMobileMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMobileMenu();
  });

  // Mobile felinos dropdown
  const mobileFelinosTrigger = document.getElementById('mobile-felinos-trigger');
  const mobileFelinosDropdown = document.getElementById('mobile-felinos-dropdown');
  const mobileFelinosChevron = document.getElementById('mobile-felinos-chevron');

  mobileFelinosTrigger?.addEventListener('click', () => {
    const isOpen = mobileFelinosTrigger.getAttribute('aria-expanded') === 'true';
    if (isOpen) {
      mobileFelinosDropdown?.classList.add('hidden');
      mobileFelinosTrigger.setAttribute('aria-expanded', 'false');
      mobileFelinosChevron?.classList.remove('rotate-180');
    } else {
      mobileFelinosDropdown?.classList.remove('hidden');
      mobileFelinosTrigger.setAttribute('aria-expanded', 'true');
      mobileFelinosChevron?.classList.add('rotate-180');
    }
  });

  // Header scroll — swap background, logo & nav colors
  const header = document.getElementById('header-main');
  const logoWhite = document.getElementById('logo-white');
  const logoColor = document.getElementById('logo-color');
  const navFelinos = document.getElementById('felinos-trigger');
  const navLibros = document.getElementById('nav-libros');
  const burger = document.getElementById('burger-trigger');
  const navItems = [navFelinos, navLibros].filter(Boolean);
  let scrolled = false;

  function toggleNavItem(el, s) {
    const active = el.dataset.active === 'true';
    if (s) {
      el.classList.remove('text-white', 'text-white/80', 'hover:text-white', 'border-white');
      el.classList.add('text-base-700', 'hover:text-black');
      if (active) el.classList.add('border-base-700');
    } else {
      el.classList.remove('text-base-700', 'hover:text-black', 'border-base-700');
      if (active) {
        el.classList.add('border-white', 'text-white');
      } else {
        el.classList.add('text-white/80', 'hover:text-white');
      }
    }
  }

  function updateHeader() {
    const s = window.scrollY > 50;
    if (s === scrolled) return;
    scrolled = s;

    header?.setAttribute('data-scrolled', String(s));

    logoWhite?.classList.toggle('hidden', s);
    logoColor?.classList.toggle('hidden', !s);

    navItems.forEach(el => toggleNavItem(el, s));

    if (burger) {
      burger.classList.toggle('text-base-700', s);
      burger.classList.toggle('text-white', !s);
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
</script>
