---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import BookCard from '@/components/BookCard.astro';
import Hero from '@/components/Hero.astro';
import { SITE } from '@/site.config';

import heroImage from '@/assets/images/books/books-hero.jpg';

const booksEntries = await getCollection('books');
const books = booksEntries[0]!.data.books;
---

<Layout title={`Libros recomendados | ${SITE.name}`} description="Libros recomendados">
  <Hero
    title="Libros recomendados"
    subtitle="Una selección de publicaciones científicas y de divulgación sobre los felinos silvestres de Argentina"
    image={heroImage}
    alt=""
    size="narrow"
  />

  <section class="bg-stone-50 py-20">
    <div class="mx-auto max-w-7xl px-6">
      <ul class="m-0 grid list-none grid-cols-1 gap-8 p-0 md:grid-cols-2">
        {
          books.map((book, i) => (
            <li data-reveal data-animation="animate-fade-in-up" data-delay={i * 60}>
              <BookCard
                title={book.title}
                authors={book.authors}
                editorial={book.editorial}
                year={book.year}
                cover={book.cover}
                description={book.description}
                links={book.links}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
