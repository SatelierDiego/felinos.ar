---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionBlock from '../components/SectionBlock.astro';
import HighlightBlock from '../components/HighlightBlock.astro';
import SpeciesGrid from '../components/SpeciesGrid.astro';
import Hero from '../components/Hero.astro';
import { SITE } from '../site.config';

const homeEntries = await getCollection('home');
const home = homeEntries[0]!.data;
const felinosOrdenados = [...home.felinos].sort((a, b) => a.title.localeCompare(b.title, 'es'));

const orgId = `${SITE.url}/#organization`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    publisher: {
      '@id': orgId,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': orgId,
    name: SITE.name,
    url: SITE.url,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE.url}/images/felinoar-logo.svg`,
    },
    sameAs: [SITE.social.instagram, SITE.social.twitter, SITE.social.facebook],
  },
];
---

<Layout
  title={`${SITE.name} | Conocé los felinos silvestres de Argentina`}
  description="Conocé los felinos silvestres de Argentina: yaguareté, puma, gato andino y más. Información sobre su biología, hábitat y conservación."
  jsonLd={jsonLd}
>
  <Hero
    title={home.hero.title}
    subtitle={home.hero.subtitle}
    image={home.hero.image}
    alt={home.hero.alt}
    author={home.hero.author}
    cta={home.hero.cta}
  />

  {
    home.sections.map((section) =>
      section.type === 'highlight' ? (
        <HighlightBlock
          id={section.id}
          title={section.title}
          content={section.content}
          separatorBefore={section.separatorBefore}
          separatorAfter={section.separatorAfter}
        />
      ) : (
        <SectionBlock
          id={section.id}
          title={section.title}
          content={section.content}
          separatorBefore={section.separatorBefore}
          separatorAfter={section.separatorAfter}
        />
      )
    )
  }

  <!-- ── Species grid ──────────────────────────────────────────── -->
  <SpeciesGrid felinos={felinosOrdenados} />
</Layout>
