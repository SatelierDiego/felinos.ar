---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PhotographerRow from '@/components/PhotographerRow.astro';
import { SITE } from '@/site.config';
import Hero from '@/components/Hero.astro';

import heroImage from '@/assets/images/photographers/photographers-hero.jpg';

const entries = await getCollection('photographers');
const photographers = entries[0]!.data.photographers.slice().sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

const felinosEntries = await getCollection('felinos');
const felinosByScientificName = new Map(felinosEntries.map((f) => [f.data.scientific_name.toLowerCase(), f.data.slug]));

const pageUrl = new URL(`/fotografos/`, Astro.site);
---

<Layout
  title={`Fotógrafos | ${SITE.name}`}
  description={`Fotógrafos que colaboraron con imágenes para ${SITE.name}.`}
  canonicalUrl={pageUrl.href}
>
  <Hero
    title="Fotógrafos"
    subtitle="Fotógrafos que colaboraron con su trabajo para hacer posible este proyecto"
    image={heroImage}
    alt=""
    size="narrow"
  />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-6">
      <ul class="divide-base-100 m-0 list-none divide-y p-0">
        {
          photographers.map((f, i) => (
            <PhotographerRow
              nombre={f.nombre}
              contacto={f.contacto}
              felinos={f.felinos}
              felinosByScientificName={felinosByScientificName}
            />
          ))
        }
      </ul>
    </div>
    <p>
      ¿Falta algún dato de los fotógrafos o hay algo incorrecto? Escribinos a <a href="mailto:contacto@felinos.ar"
        >contacto@felinos.ar</a
      >
    </p>
  </section>
</Layout>
